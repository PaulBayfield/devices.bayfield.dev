{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devices",
  "version": "../package.json",
  "identifier": "dev.bayfield.devices",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Devices",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "binaries/devices-agent/": "agent/" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NzZBNzc1RjgxOUYxNjQKUldSazhSbjRkYWQycHhsOC9uM1NlQm5iRWh4RUZuWEFsYXhiVWl2RW1ZaS9SZDhYUit3QkhsZzgK",
      "endpoints": [
        "https://github.com/PaulBayfield/devices.bayfield.dev/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
